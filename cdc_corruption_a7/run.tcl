# run.tcl — one-command Vivado / XSim flow for the Artix-7 CDC corruption port.
#
#   vivado -mode batch -source run.tcl -tclargs <stage> [<stage> ...]
#
# Stages (the Makefile wraps each of these):
#
#   behav   behavioral simulation of the RTL          -> build/behav.log, .vcd
#   synth   synthesis + the CDC audit                 -> build/post_synth.dcp
#   cdc     re-run the CDC audit on an existing dcp   -> build/cdc/*.rpt
#   impl    place & route + timing report + timesim   -> build/post_route.dcp,
#           netlist and SDF                              top_a7_timesim.v/.sdf
#   timing  post-implementation TIMING simulation     -> build/timing.log, .vcd
#   trap    two-pass: find the FIRST tear, then dump  -> build/trap_pass*.log
#           only the waveform window around it           + a 400 ns .vcd
#   all     behav synth cdc impl timing
#
# Non-project mode throughout: no .xpr, no GUI state, nothing that has to be
# regenerated by hand after a git clone. `open_checkpoint build/post_route.dcp`
# in the GUI over DCV whenever you want to look at something.

set stages $argv
if {[llength $stages] == 0 || $stages eq "all"} {
    set stages {behav synth impl timing}
}

# ─────────────────────────────────────────────────────────────────────────────
# Configuration
# ─────────────────────────────────────────────────────────────────────────────
set PART   xc7a35ticsg324-1L      ;# Arty A7-35T. -35T -> -100T is a one-line change.
set TOP    top_a7
set OUT    [file normalize build]

# Simulation link speed. 100 MHz / 16 = 6.25 Mbaud. The DUT gets this as a
# `define at read time; the testbench gets the matching CLKS_PER_BIT as a
# parameter. They must agree or the readout hangs.
set SIM_CPB  16
set SIM_BAUD [expr {100000000 / $SIM_CPB}]

# How long each simulation free-runs before the register readout. Behavioral
# costs nothing, so run long. Post-implementation timing simulation with full
# SDF annotation is roughly 1000x slower — keep it short and rely on the
# testbench's phase walk rather than on elapsed time to find the aperture.
set OBS_US_BEHAV  200
set OBS_US_TIMING 30

# Half-width of the waveform window the trap stage dumps around the first tear.
set TRAP_PAD_NS 200.0

# Everything this project needs is inside this directory. rtl/ holds byte-identical
# copies of the shared cores, not symlinks or ../ references, so the whole thing
# rsyncs to the instance as one self-contained tree. `make check-sync` proves the
# copies still match the iCE40 originals when the repo is around.
set RTL {
    top_a7.v
    rtl/corrupt.v
    rtl/readout.v
    rtl/cdc_capture.v
    rtl/uart_rx.v
    rtl/uart_tx.v
}
set TB  tb_cdc_corruption.sv
set XDC cdc_corruption_a7.xdc

file mkdir $OUT

proc banner {msg} {
    puts ""
    puts "── $msg [string repeat - [expr {max(1, 68 - [string length $msg])}]]"
}

# exec that streams to the console instead of buffering, and fails loudly.
proc run {args} {
    puts "\$ $args"
    if {[catch {exec {*}$args >@ stdout 2>@ stderr} err]} {
        error "command failed: $args\n$err"
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# behav — behavioral simulation
# ─────────────────────────────────────────────────────────────────────────────
proc stage_behav {} {
    global OUT RTL TB TOP SIM_CPB SIM_BAUD OBS_US_BEHAV
    banner "behavioral simulation"
    set here [pwd]
    cd $OUT
    set rtl {}
    foreach f $RTL { lappend rtl [file join $here $f] }

    run xvlog -d BAUD_DEFAULT=$SIM_BAUD {*}$rtl -log xvlog_behav.log
    run xvlog -sv [file join $here $TB] -log xvlog_tb.log
    # unisims_ver supplies BUFG / STARTUPE2 behavioral models; glbl supplies GSR.
    run xelab -L unisims_ver -debug typical --timescale 1ns/1ps \
        -generic_top "CLKS_PER_BIT=$SIM_CPB" \
        -generic_top "OBS_US=$OBS_US_BEHAV" \
        tb_cdc_corruption glbl -s tb_behav -log xelab_behav.log
    run xsim tb_behav -runall -log behav.log
    cd $here
    puts "behavioral: $OUT/behav.log  waveform: $OUT/cdc_corruption_a7.vcd"
}

# ─────────────────────────────────────────────────────────────────────────────
# synth — synthesis, then the CDC audit
# ─────────────────────────────────────────────────────────────────────────────
proc stage_synth {} {
    global OUT RTL XDC TOP PART SIM_BAUD
    banner "synthesis"
    foreach f $RTL { read_verilog $f }
    read_xdc $XDC

    # The whole design is a study in registers that a synthesiser would love to
    # optimise away, so: no flattening, and the naive read paths are pinned.
    synth_design -top $TOP -part $PART -flatten_hierarchy none \
                 -verilog_define BAUD_DEFAULT=$SIM_BAUD

    # (* keep *) in the source is advisory. DONT_TOUCH on the synthesized cells
    # is not. Without this, opt_design is entitled to notice that nd_r and
    # n2_meta are two chains sampling the same bus and merge them — which would
    # silently turn the demo's two independent wrong answers into one, and the
    # "naive 2FF is no better than naive" result would become an artifact of the
    # tool rather than a fact about the hardware.
    foreach pat {nd_r n2_meta gray_meta gray_sync gray_naked hf_gray hf_count} {
        set cells [get_cells -quiet -hier -filter "NAME =~ *${pat}_reg*"]
        if {[llength $cells]} {
            set_property DONT_TOUCH TRUE $cells
            puts "  DONT_TOUCH on [llength $cells] cell(s) matching ${pat}_reg"
        } else {
            puts "  WARNING: no cells matched ${pat}_reg — the demo may be compromised"
        }
    }

    write_checkpoint -force $OUT/post_synth.dcp
    report_utilization -file $OUT/utilization_synth.rpt
    puts "checkpoint: $OUT/post_synth.dcp"
}

# ─────────────────────────────────────────────────────────────────────────────
# cdc — the audit (also run automatically at the end of synth)
# ─────────────────────────────────────────────────────────────────────────────
proc stage_cdc {} {
    global OUT
    banner "CDC audit"
    if {[llength [get_cells -quiet -hier]] == 0} {
        open_checkpoint $OUT/post_synth.dcp
    }
    source report_cdc.tcl
}

# ─────────────────────────────────────────────────────────────────────────────
# impl — place & route, timing reports, and the timing-sim netlist
# ─────────────────────────────────────────────────────────────────────────────
proc stage_impl {} {
    global OUT TOP
    banner "implementation"
    if {[llength [get_cells -quiet -hier]] == 0} {
        open_checkpoint $OUT/post_synth.dcp
    }
    opt_design
    place_design
    phys_opt_design
    route_design

    write_checkpoint -force $OUT/post_route.dcp
    report_timing_summary  -file $OUT/timing_summary.rpt -warn_on_violation
    report_utilization     -file $OUT/utilization_impl.rpt
    report_clock_utilization -file $OUT/clock_utilization.rpt

    # The two artifacts the timing simulation needs. -sdf_anno false: the SDF is
    # attached by xelab -sdfmax instead of by an embedded $sdf_annotate, which
    # keeps the netlist reusable and makes the annotation visible in the log.
    write_verilog -force -mode timesim -sdf_anno false $OUT/${TOP}_timesim.v
    write_sdf     -force -process_corner slow          $OUT/${TOP}_timesim.sdf

    # Worth a look even though set_clock_groups made the async paths unreported:
    # this is the number that is honest about the *intra*-domain timing, and if
    # the async domain itself does not close, the experiment is measuring the
    # wrong thing.
    set wns [get_property SLACK [get_timing_paths -delay_type max]]
    puts "post-route WNS: $wns ns"
    write_bitstream -force $OUT/${TOP}.bit
    puts "bitstream: $OUT/${TOP}.bit"
}

# ─────────────────────────────────────────────────────────────────────────────
# timing — post-implementation timing simulation, SDF-annotated
# ─────────────────────────────────────────────────────────────────────────────
proc stage_timing {} {
    global OUT TB TOP SIM_CPB OBS_US_TIMING
    banner "post-implementation timing simulation"
    set here [pwd]
    cd $OUT
    if {![file exists ${TOP}_timesim.v]} {
        error "no timing netlist — run the impl stage first"
    }

    run xvlog ${TOP}_timesim.v -log xvlog_timesim.log
    run xvlog -sv [file join $here $TB] -log xvlog_tb_timing.log

    # -transport_int_delays with the pulse filters open is the point of this
    # whole stage. By default XSim swallows pulses narrower than the cell delay
    # as glitches. Those glitches are the evidence. Let them through.
    run xelab -L simprims_ver -L unisims_ver -debug typical --timescale 1ns/1ps \
        -transport_int_delays -pulse_r 0 -pulse_int_r 0 \
        -sdfmax /tb_cdc_corruption/dut=[file join $OUT ${TOP}_timesim.sdf] \
        -generic_top "CLKS_PER_BIT=$SIM_CPB" \
        -generic_top "OBS_US=$OBS_US_TIMING" \
        tb_cdc_corruption glbl -s tb_timing -log xelab_timing.log
    run xsim tb_timing -runall -log timing.log
    cd $here
    puts "timing sim: $OUT/timing.log  waveform: $OUT/cdc_corruption_a7.vcd"
    puts ""
    puts "Timing violations are reported by the SIMPRIM models as they occur;"
    puts "grep the log for them — each one is an async edge caught inside a"
    puts "capture flop's setup/hold window, which is the event the board counts:"
    puts "    grep -i 'timing violation' $OUT/timing.log | head"
}

# ─────────────────────────────────────────────────────────────────────────────
# trap — find the FIRST tear and dump only the waveform around it
# ─────────────────────────────────────────────────────────────────────────────
# Two passes, because a VCD cannot rewind: nothing can decide to start dumping
# after the interesting thing has already happened. Pass 1 dumps nothing and
# reports when the first tear occurred. Pass 2 re-runs and dumps a narrow window
# around that time.
#
# This is only sound because the testbench is deterministic — no $random, a
# fixed phase sawtooth — so the same netlist triggers at the same simulated
# instant every run. If that ever stops being true, this stage silently starts
# dumping the wrong window, so do not introduce randomness without revisiting it.
#
# The trigger watches led[3:1], which top_a7 drives from the tear counters. A
# top-level PIN, not a hierarchical name: in this netlist tear_nd is 32
# separately-named flops, and a hierarchical reference from the testbench would
# not survive. The same trigger therefore works in behavioral sim, in timing
# sim, and on the board.
proc grep_trigger {logfile} {
    set fh [open $logfile r]
    set txt [read $fh]
    close $fh
    if {[regexp {TRIGGER\s+first tear at ([0-9.]+) ns} $txt -> t]} { return $t }
    return ""
}

proc stage_trap {} {
    global OUT TB TOP SIM_CPB OBS_US_TIMING TRAP_PAD_NS
    banner "trap on first tear — two-pass timing simulation"
    set here [pwd]
    cd $OUT
    if {![file exists ${TOP}_timesim.v]} {
        error "no timing netlist — run the impl stage first"
    }
    set sdf [file join $OUT ${TOP}_timesim.sdf]

    run xvlog ${TOP}_timesim.v -log xvlog_timesim.log
    run xvlog -sv [file join $here $TB] -log xvlog_tb_trap.log

    # Pass 1 — DUMP_FROM_NS beyond the end of the run means $dumpon never fires,
    # so this costs no VCD at all. Note HIER_OK is NOT defined: the trigger
    # reports its time from a pin, and the per-path value dump it would print is
    # hierarchical and unavailable here.
    puts "pass 1: locating the first tear (no waveform)"
    run xelab -L simprims_ver -L unisims_ver --timescale 1ns/1ps \
        -transport_int_delays -pulse_r 0 -pulse_int_r 0 \
        -sdfmax /tb_cdc_corruption/dut=$sdf \
        -generic_top "CLKS_PER_BIT=$SIM_CPB" \
        -generic_top "OBS_US=$OBS_US_TIMING" \
        -generic_top "TRIG_MODE=1" \
        -generic_top "DUMP_FROM_NS=1.0e12" \
        tb_cdc_corruption glbl -s tb_trap1 -log xelab_trap1.log
    run xsim tb_trap1 -runall -log trap_pass1.log

    set t [grep_trigger trap_pass1.log]
    if {$t eq ""} {
        cd $here
        puts ""
        puts "No tear occurred in [set OBS_US_TIMING] us of timing simulation."
        puts "That is a real result, not a failure — but check, in this order:"
        puts "  1. did the SDF actually annotate? grep xelab_trap1.log for 'SDF'"
        puts "  2. raise OBS_US_TIMING, or widen ASYNC_DRIFT so the async edge"
        puts "     sweeps the capture aperture faster"
        puts "  3. confirm DONT_TOUCH kept the naive paths — see the synth log"
        return
    }

    set lo [expr {$t - $TRAP_PAD_NS}]
    set hi [expr {$t + $TRAP_PAD_NS}]
    puts ""
    puts "pass 2: first tear at $t ns — dumping \[$lo, $hi\] ns only"
    run xelab -L simprims_ver -L unisims_ver -debug typical --timescale 1ns/1ps \
        -transport_int_delays -pulse_r 0 -pulse_int_r 0 \
        -sdfmax /tb_cdc_corruption/dut=$sdf \
        -generic_top "CLKS_PER_BIT=$SIM_CPB" \
        -generic_top "OBS_US=$OBS_US_TIMING" \
        -generic_top "TRIG_MODE=1" \
        -generic_top "TRIG_STOP_NS=$TRAP_PAD_NS" \
        -generic_top "DUMP_FROM_NS=$lo" \
        -generic_top "DUMP_TO_NS=$hi" \
        -generic_top "DUMP_DEPTH=0" \
        tb_cdc_corruption glbl -s tb_trap2 -log xelab_trap2.log
    run xsim tb_trap2 -runall -log trap_pass2.log
    cd $here

    puts ""
    puts "waveform: $OUT/cdc_corruption_a7.vcd — [expr {2*$TRAP_PAD_NS}] ns around the first tear,"
    puts "full hierarchy, which is affordable precisely because the window is small."
}

# ─────────────────────────────────────────────────────────────────────────────
foreach s $stages {
    switch -- $s {
        behav   { stage_behav }
        synth   { stage_synth ; stage_cdc }
        cdc     { stage_cdc }
        impl    { stage_impl }
        timing  { stage_timing }
        trap    { stage_trap }
        default { error "unknown stage '$s' (behav | synth | cdc | impl | timing | trap | all)" }
    }
}
banner "done"
